# This file is to be linked as .envrc into systemd.

# This resolves to systemd-dev.
_rc=$(realpath "${BASH_SOURCE[0]}")
_tooling=$(dirname "$_rc")

# PWD resolves to the systemd dir.
export SYSTEMD_SRC=$PWD

# mkosi must be checked out next to the systemd repository. Anchor on the
# systemd repository root so this works whether systemd is a plain checkout
# or a worktree, then look for a sibling mkosi.
_common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
_sysroot=${_common:+$(dirname "$_common")}
_mkosi=${_sysroot:-$PWD}/../mkosi

# Accept either a plain mkosi checkout or a worktree layout; in the latter case
# use the main worktree.
if [ "$(git -C "$_mkosi" rev-parse --is-bare-repository 2>/dev/null)" = "true" ]; then
  _mkosi=$_mkosi/main
fi
export MKOSI_SRC=$(git -C "$_mkosi" rev-parse --show-toplevel 2>/dev/null || echo "$_mkosi")

use nix "$_tooling/shell.nix"
watch_file "$_rc" "$_tooling/shell.nix"
